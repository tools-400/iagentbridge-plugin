<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>

   <!--
     ==========================================================================
       UI tools of the MCP server of iAgentBridge: read and operate the user
       interface of a test instance, forwarded to it from any other RDi, and
       start and stop test instances
     ==========================================================================
   -->

   <extension point="de.tools400.iagentbridge.core.plugin.tools">
      <tool
            id="de.tools400.iagentbridge.ui.snapshot"
            class="de.tools400.iagentbridge.ui.tools.UiSnapshotTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.screenshot"
            class="de.tools400.iagentbridge.ui.tools.UiScreenshotTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.click"
            class="de.tools400.iagentbridge.ui.tools.UiClickTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.type"
            class="de.tools400.iagentbridge.ui.tools.UiTypeTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.select"
            class="de.tools400.iagentbridge.ui.tools.UiSelectTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.check"
            class="de.tools400.iagentbridge.ui.tools.UiCheckTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.key"
            class="de.tools400.iagentbridge.ui.tools.UiKeyTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.menu"
            class="de.tools400.iagentbridge.ui.tools.UiMenuTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.command"
            class="de.tools400.iagentbridge.ui.tools.UiCommandTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.wait"
            class="de.tools400.iagentbridge.ui.tools.UiWaitTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.lpex"
            class="de.tools400.iagentbridge.ui.tools.UiLpexTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.errorlog"
            class="de.tools400.iagentbridge.ui.tools.UiErrorLogTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.close"
            class="de.tools400.iagentbridge.ui.tools.UiCloseTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.launch.start"
            class="de.tools400.iagentbridge.ui.tools.StartLaunchTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.launch.stop"
            class="de.tools400.iagentbridge.ui.tools.StopLaunchTool">
      </tool>
      <tool
            id="de.tools400.iagentbridge.ui.launch.list"
            class="de.tools400.iagentbridge.ui.tools.ListLaunchesTool">
      </tool>
      <instructions
            file="instructions/ui-tools.txt">
      </instructions>
   </extension>

   <!--
     ==========================================================================
       Preference page of the UI tools, below the page of iAgentBridge
     ==========================================================================
   -->

   <extension point="org.eclipse.ui.preferencePages">
      <page
            id="de.tools400.iagentbridge.ui.preferences.UiToolsPreferencePage"
            category="de.tools400.iagentbridge.preferencepages.IAgentBridgePreferencePage"
            class="de.tools400.iagentbridge.ui.preferences.UiToolsPreferencePage"
            name="%PreferencePage_UI_tools">
      </page>
   </extension>

</plugin>
