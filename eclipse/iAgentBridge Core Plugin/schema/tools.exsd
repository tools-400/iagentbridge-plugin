<?xml version='1.0' encoding='UTF-8'?>
<!-- Schema file written by PDE -->
<schema targetNamespace="de.tools400.iagentbridge.core.plugin" xmlns="http://www.w3.org/2001/XMLSchema">
<annotation>
      <appInfo>
         <meta.schema plugin="de.tools400.iagentbridge.core.plugin" id="tools" name="MCP Tools"/>
      </appInfo>
      <documentation>
         Contributes a tool to the MCP server of iAgentBridge. The server creates the tools, when it starts, and lists them to the MCP client together with its own tools. A tool, that cannot be created, that fails to describe itself or whose name is invalid or already taken, is left out and reported in the Error Log. Since 1.1.0 a plug-in may also contribute instructions for the AI agent, e.g. the workflow of its tools.
      </documentation>
   </annotation>

   <element name="extension">
      <annotation>
         <appInfo>
            <meta.element />
         </appInfo>
      </annotation>
      <complexType>
         <sequence>
            <element ref="tool" minOccurs="1" maxOccurs="unbounded"/>
            <element ref="instructions" minOccurs="0" maxOccurs="1"/>
         </sequence>
         <attribute name="point" type="string" use="required">
            <annotation>
               <documentation>
               </documentation>
            </annotation>
         </attribute>
         <attribute name="id" type="string">
            <annotation>
               <documentation>
               </documentation>
            </annotation>
         </attribute>
         <attribute name="name" type="string">
            <annotation>
               <documentation>
               </documentation>
               <appInfo>
                  <meta.attribute translatable="true"/>
               </appInfo>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <element name="tool">
      <complexType>
         <attribute name="id" type="string" use="required">
            <annotation>
               <documentation>
                  Unique ID of the contribution. The name, with which the MCP client calls the tool, is returned by IMcpTool.getName().
               </documentation>
            </annotation>
         </attribute>
         <attribute name="class" type="string" use="required">
            <annotation>
               <documentation>
                  Implementation of the tool. It must have a public constructor without parameters.
               </documentation>
               <appInfo>
                  <meta.attribute kind="java" basedOn=":de.tools400.iagentbridge.mcp.IMcpTool"/>
               </appInfo>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <element name="instructions">
      <annotation>
         <documentation>
            Since 1.1.0. Instructions for the AI agent, e.g. the workflow of the tools of the plug-in. The server returns them in the result of 'initialize' after its own instructions, ordered by the IDs of the plug-ins, each after an empty line. They count only, if at least one tool of the plug-in was added, and once per plug-in; instructions, that are left out, are reported in the Error Log. MCP clients may cut long instructions: Claude Code reads the first 4096 characters of all instructions of a server, before version 2.1.296 the first 2048. Keep them short and put the important part first. A client reads them, when it connects; a changed text reaches the agent in a new session.
         </documentation>
      </annotation>
      <complexType>
         <attribute name="file" type="string" use="required">
            <annotation>
               <documentation>
                  Path of a text file in the plug-in itself, not in a fragment, e.g. instructions/tools.txt, encoded in UTF-8, in English. Line ends become '\n', white space at the start and the end is removed. Add the file to bin.includes of the build.properties.
               </documentation>
               <appInfo>
                  <meta.attribute kind="resource"/>
               </appInfo>
            </annotation>
         </attribute>
      </complexType>
   </element>

   <annotation>
      <appInfo>
         <meta.section type="since"/>
      </appInfo>
      <documentation>
         1.0.0
      </documentation>
   </annotation>

   <annotation>
      <appInfo>
         <meta.section type="examples"/>
      </appInfo>
      <documentation>
         &lt;extension point=&quot;de.tools400.iagentbridge.core.plugin.tools&quot;&gt;
   &lt;tool
         id=&quot;com.example.iagentbridge.mytool&quot;
         class=&quot;com.example.iagentbridge.MyTool&quot;&gt;
   &lt;/tool&gt;
   &lt;instructions file=&quot;instructions/tools.txt&quot;/&gt;
&lt;/extension&gt;
      </documentation>
   </annotation>

   <annotation>
      <appInfo>
         <meta.section type="apiinfo"/>
      </appInfo>
      <documentation>
         The tool implements de.tools400.iagentbridge.mcp.IMcpTool and returns a McpToolResult. ToolArguments reads the arguments. The server handles one request after the other, outside of the UI thread.
      </documentation>
   </annotation>

</schema>
